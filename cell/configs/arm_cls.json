{
 "arm": "cls",
 "arm_description": "UNI2 slot filled by the cls readout alone. Head, losses, caps, seed and schedule are identical to the cls_sigma3 arm; only the uni2 slot roots and the output paths differ. Schwann cells outside an accepted Nerve Define region are removed from the identity objective (inputs.identity_exclusion); every other cell keeps its label.",
 "experiment_id": "heid_cls",
 "inputs": {
  "cell_features": {
   "mode": "fold_aware",
   "phikon_eval_subdir": "oof/fold{fold}",
   "phikon_part_dims": [
    1024
   ],
   "phikon_root": "${PROJECTS_ROOT}/cell/outputs/features/phikon",
   "phikon_train_subdir": "train/fold{fold}",
   "uni2_eval_subdir": "oof/fold{fold}",
   "uni2_part_dims": [
    1536
   ],
   "uni2_root": [
    "${PROJECTS_ROOT}/cell/outputs/features/uni2/cls"
   ],
   "uni2_train_subdir": "train/fold{fold}",
   "vocabulary": "refine17"
  },
  "data_contract": "cell/configs/data_contract.json",
  "identity_exclusion": {
   "labels_root": "${PROJECTS_ROOT}/cell/outputs/labels_region_schwann",
   "manifest": "cell/configs/identity_exclusion_manifest.json",
   "manifest_sha256": "c7e135c12ee1f544c0f402516bedd098ca2fcf98ec4d80632e1d74263b1e29b7"
  },
  "row_identity": {
   "frame_eval_subdir": "oof/fold{fold}",
   "frame_phikon_root": "${PROJECTS_ROOT}/cell/outputs/features/phikon",
   "frame_train_subdir": "train/fold{fold}",
   "frame_uni2_dim": 1536,
   "frame_uni2_root": "${PROJECTS_ROOT}/cell/outputs/features/uni2/cls",
   "frozen_phikon_root": "${PROJECTS_ROOT}/cell/outputs/features/frozen_phikon_cls",
   "frozen_uni2_dim": 1536,
   "frozen_uni2_root": "${PROJECTS_ROOT}/cell/outputs/features/frozen_uni2_cls",
   "head_selection_root": "${PROJECTS_ROOT}/cell/outputs/manifests/head_selection",
   "phikon_eval_subdir": "oof/fold{fold}",
   "phikon_train_subdir": "train/fold{fold}",
   "shared_scratch": "cell/outputs/scratch/shared",
   "tissue_grid_root": "${PROJECTS_ROOT}/cell/outputs/features/tissue_grid"
  },
  "taxonomy": "cell/configs/taxonomy_coarse11.json"
 },
 "model": {
  "cell_feature_dropout": 0.05,
  "dropout": 0.2,
  "grid_dim": 3072,
  "grid_feature_dropout": 0.15,
  "hidden_dim": 512,
  "n_identity": 11,
  "n_lineage": 6,
  "necrosis_dropout": 0.2,
  "necrosis_hidden_dim": 512,
  "phikon_dim": 1024,
  "projection_dim": 256,
  "uni2_dim": 1536
 },
 "outputs": {
  "logs": "cell/outputs/logs",
  "manifests": "cell/outputs/manifests/head",
  "models": "cell/outputs/models/head/cls",
  "oof": "cell/outputs/oof/cls",
  "results": "cell/outputs/results/cls",
  "scratch": "cell/outputs/scratch/cls"
 },
 "python": "${PYTHON:-python}",
 "sampling": {
  "cap_per_refine17_class": 400000,
  "necrosis_positive_cap": 400000,
  "patient_balancing": "none",
  "policy": "v7.post_merge_prior_repair_boundary_capped.v1",
  "post_merge_cap_per_final_class": 400000
 },
 "schema_version": "v5.experiment.v1",
 "training": {
  "amp_dtype": "bfloat16",
  "batch_size": 4096,
  "class_weight_mode": "uniform",
  "epochs": 12,
  "eval_batch_size": 32768,
  "gradient_clip_norm": 1.0,
  "label_smoothing": 0.02,
  "learning_rate": 0.0003,
  "lineage_loss_weight": 0.15,
  "necrosis_loss_weight": 0.25,
  "necrosis_pos_weight_max": 10.0,
  "rdrop_js_weight": 0.1,
  "seed": 25073,
  "warmup_fraction": 0.08,
  "weight_decay": 0.0001
 },
 "version_root": "cell",
 "workspace_root": "${RELEASE_ROOT}"
}
