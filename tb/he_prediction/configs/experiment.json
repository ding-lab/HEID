{
  "cohort": {
    "folds": 5,
    "group": "patient",
    "low_quality_alignment_policy": "exclude_failed_alignment_sections",
    "stratify": "cancer"
  },
  "evaluation": {
    "area": [
      "tumor_fraction_absolute_error",
      "tumor_area_bias_mm2"
    ],
    "boundary": [
      "surface_dice_20um",
      "surface_dice_50um",
      "assd_um",
      "hd95_um"
    ],
    "decision_threshold_selection": "inner_patient_split_only",
    "outer_fold_rule": "strict_own_fold_prediction",
    "primary": [
      "patient_equal_tumor_dice",
      "patient_equal_tumor_iou"
    ],
    "report_by": [
      "patient",
      "sample",
      "cancer",
      "fold"
    ],
    "uncertainty": "cancer_stratified_patient_bootstrap"
  },
  "experiment_id": "tb_territory_prediction",
  "label_transfer": {
    "cancer_overrides": {
      "PDAC": {
        "minimum_region_area_px": 100,
        "region_closing_radius_px": 2,
        "region_relative_density_threshold": 0.03,
        "region_sigma_px": 3.0
      }
    },
    "cell_type_seed_source": "gen11_boundary_csv_cell_type_joined_by_cell_id",
    "classification_target": "tumor_mask_within_valid_tissue",
    "coordinate_source": "corrected_aligned_cell_table_he_px_he_py",
    "grid_resolution_um": 10.0,
    "he_mpp_um": 0.2125,
    "interface_sdf_role": "diagnostic_only_and_masked_when_interface_empty",
    "margin_um": 100.0,
    "maximum_hole_area_px": 50000,
    "minimum_normal_area_px": 3000,
    "minimum_region_area_px": 500,
    "region_closing_radius_px": 5,
    "region_opening_radius_px": 3,
    "region_relative_density_threshold": 0.1,
    "region_sigma_px": 5.0,
    "regression_target": "gen11_tumor_mask_sdf_um",
    "sdf_sign": "positive_outside_negative_inside",
    "tissue_closing_radius_px": 10,
    "tissue_density_threshold": 0.015,
    "tissue_sigma_px": 10.0
  },
  "model": {
    "baseline_architecture": "multiscale_rgb_encoder_decoder",
    "candidate_selection": "inner_patient_split_only",
    "candidate_upgrade": "pathology_foundation_feature_fusion",
    "foundation_candidates": [
      "v4_uni2_phikon_region_context",
      "virchow2_rgb_feature_fusion"
    ],
    "outputs": [
      "tumor_logit",
      "clipped_sdf_um"
    ],
    "primary_endpoint": "direct_dense_rgb_segmentation",
    "reference_cell_baseline": "v4_10class_stainaug_tumor_probability_to_gen11_rasterizer",
    "sdf_clip_um": 500.0
  },
  "outputs": {
    "data_contract": "data/manifests/data_contract.json",
    "label_dataset_contract": "data/manifests/label_dataset.json",
    "label_manifest": "data/manifests/labels.csv",
    "labels": "${RELEASE_ROOT}/tb/he_prediction/data/labels",
    "logs": "outputs/logs/training",
    "manifests": "outputs/training/manifests",
    "models": "outputs/training/models",
    "predictions": "outputs/training/predictions",
    "results": "outputs/training/results",
    "scratch": "scratch/training",
    "source_manifest": "data/manifests/source_cohort.csv"
  },
  "preprocessing": {
    "arm_selection": "inner_patient_split_only",
    "axes": "YXS",
    "blank_policy": "ignore_outside_valid_tissue_and_white_warp_background",
    "color_space": "native_rgb",
    "image": "aligned_he_ome_tiff_level0",
    "label_mpp_um": 10.0,
    "label_shape_yx": [
      256,
      256
    ],
    "model_input_mpp_um": 2.5,
    "model_input_shape_yx": [
      1024,
      1024
    ],
    "patch_fov_um": 2560.0,
    "physical_coordinate_origin": "xenium_canvas_upper_left_pixel_edge",
    "test_time_normalization": "none",
    "training_arms": [
      "native_rgb",
      "training_fold_only_stain_augmentation"
    ]
  },
  "sampling": {
    "boundary_candidate_um": 250.0,
    "minimum_valid_tissue_fraction": 0.5,
    "patient_equal_epoch_weighting": true,
    "tile_strata": [
      "boundary",
      "tumor_interior",
      "normal_tissue"
    ],
    "tile_stratum_weights": [
      0.4,
      0.3,
      0.3
    ],
    "unit": "physical_tile"
  },
  "schema_version": "he_boundary_prediction.v1.experiment.v1",
  "task": {
    "claim_boundary": "agreement_with_xenium_derived_gen11_silver_labels",
    "endpoint": "aligned_he_to_binary_tumor_territory_mask",
    "ignore_class": "outside_valid_tissue_or_aligned_he_canvas",
    "negative_class": "tissue_mask_and_not_tumor_mask",
    "positive_class": "gen11_tumor_mask"
  },
  "training": {
    "amp_dtype": "bfloat16",
    "batch_size_per_gpu": 4,
    "epochs": 40,
    "gradient_accumulation_steps": 4,
    "gradient_clip_norm": 1.0,
    "learning_rate": 0.0001,
    "loss": {
      "masked_cross_entropy": 1.0,
      "masked_sdf_smooth_l1": 0.25,
      "soft_dice": 1.0
    },
    "optimizer": "adamw",
    "outer_test_checkpoint_selection": false,
    "replicate": 0,
    "scheduler": "cosine",
    "seed": 24073,
    "warmup_fraction": 0.05,
    "weight_decay": 0.0001
  }
}
